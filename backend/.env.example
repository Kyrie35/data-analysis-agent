# DeepSeek API Key（在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 可选，默认 deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# 登录 JWT 密钥（生产环境务必修改）
JWT_SECRET=change-me-to-a-long-random-string

# 可选数据库；默认使用 backend/data/app.db（SQLite）
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ---- NL2SQL 业务样例库（与上面应用库分开）----
# MySQL 示例：mysql+pymysql://nl2sql_ro:nl2sql_ro_pass@127.0.0.1:3306/nl2sql_demo
# ANALYTICS_DATABASE_URL=

# 允许查询的表白名单（逗号分隔）
# NL2SQL_TABLE_WHITELIST=regions,customers,products,orders,order_items

# 查询结果最大行数、预览行数、超时（秒）
# NL2SQL_MAX_ROWS=1000
# NL2SQL_PREVIEW_ROWS=50
# NL2SQL_QUERY_TIMEOUT_SECONDS=30
